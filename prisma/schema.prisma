// Prisma schema fyrir bókunarkerfi MK matreiðslu- og þjónustudeildar
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MealType {
  LUNCH
  DINNER
}

enum SittingStatus {
  OPEN
  CLOSED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// Ein æfing (hádegis- eða kvöldverður) sem hægt er að bóka sæti á.
model Sitting {
  id               String        @id @default(cuid())
  date             DateTime
  mealType         MealType
  title            String
  menuDescription  String?
  maxSeats         Int
  pricePerSeat     Int // krónur, heil tala til að forðast fljótandi kommu í peningum
  paymentReference String? // t.d. "HÆ01" — skýring sem gestir eiga að merkja greiðslu sína með
  status           SittingStatus @default(OPEN)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  bookings Booking[]
  waitlist WaitlistEntry[]

  @@index([date])
}

/// Bókun eins gests/hóps á tiltekinni æfingu.
model Booking {
  id                  String        @id @default(cuid())
  sittingId           String
  sitting             Sitting       @relation(fields: [sittingId], references: [id], onDelete: Cascade)
  name                String
  email               String
  phone               String
  partySize           Int
  notes               String?
  status              BookingStatus @default(CONFIRMED)
  isPaid              Boolean       @default(false)
  cancelToken         String        @unique @default(cuid())
  reminderSentAt      DateTime?
  finalReminderSentAt DateTime? // seinni áminning ef ógreitt nálægt viðburði
  eventReminderSentAt DateTime? // einföld áminning um viðburðinn sjálfan, ekki greiðslu
  ip                  String? // notað til að takmarka fjölda bókana frá sömu nettengingu (spam-vörn)
  marketingOptIn      Boolean       @default(false) // gestur hakaði við "já takk" fyrir fréttabréf
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([sittingId])
  @@index([email])
  @@index([ip, createdAt])
}

/// Gestur sem skráir sig á biðlista þegar æfing er fullbókuð.
model WaitlistEntry {
  id         String    @id @default(cuid())
  sittingId  String
  sitting    Sitting   @relation(fields: [sittingId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String
  partySize  Int
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([sittingId])
}

/// Netfang sem er skráð beint á póstlista, óháð bókun (t.d. eftir símtal).
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Stjórnandi sem getur skráð sig inn á /admin.
model AdminUser {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
}

/// Stakur lykill/gildi stillingatafla — greiðsluupplýsingar o.fl. sem
/// starfsfólk getur breytt án kóðabreytinga.
model Settings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
