# Postgres tengistrengur. Í Vercel: tengdu Vercel Postgres eða Neon og
# límdu tengistrenginn sem þau gefa þér hér.
DATABASE_URL="postgresql://user:password@localhost:5432/mk_booking?schema=public"

# Resend (tölvupóstur) — https://resend.com/api-keys
# Sendingarlénið (t.d. mk.is) þarf að vera staðfest í Resend með DNS-færslum
# áður en tölvupóstur kemst til skila í raunverulegri notkun.
RESEND_API_KEY=""
EMAIL_FROM="MK Bókanir <bokanir@mk.is>"

# Undirskriftarlykill fyrir innskráningarlotu stjórnenda.
# Búa til með: openssl rand -base64 32
SESSION_SECRET=""

# Leynilykill sem Vercel Cron notar til að kalla á /api/cron/send-reminders.
# Vercel bætir sjálfkrafa við "Authorization: Bearer $CRON_SECRET" hausnum
# fyrir cron-köll þegar þessi breyta er sett í verkefninu.
# Búa til með: openssl rand -base64 32
CRON_SECRET=""

# Slóð vefsins, notuð í hlekkjum í tölvupósti (t.d. afbókunarhlekk).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Notað eingöngu af `npx prisma db seed` til að búa til fyrsta stjórnandann.
ADMIN_EMAIL="admin@mk.is"
ADMIN_PASSWORD=""

# Kortagreiðslugátt (Teya, áður Borgun) — VALKVÆTT. Þangað til þessar
# breytur eru settar er kortagreiðsla óvirk og allt virkar áfram nákvæmlega
# eins og áður (millifærsla í tölvupósti). Fylla út þegar samningur og
# tæknigögn hafa borist frá Teya — sjá gátlistann sem fjármálastjóri fékk.
TEYA_MERCHANT_ID=""
TEYA_API_KEY=""
TEYA_API_SECRET=""
TEYA_WEBHOOK_SECRET=""
